{
  "name": "@woosopyi/redpen",
  "version": "0.3.2",
  "description": "Mark fixes right on your HTML slides in the browser and send them, with slide numbers, context and source lines, to the Claude Code / Codex session that made them (빨간펜).",
  "keywords": [
    "claude-code",
    "codex",
    "agent-skill",
    "ai",
    "html",
    "slides",
    "presentation",
    "review",
    "feedback",
    "redpen"
  ],
  "homepage": "https://github.com/WoosopYi/redpen#readme",
  "bugs": {
    "url": "https://github.com/WoosopYi/redpen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WoosopYi/redpen.git"
  },
  "license": "MIT",
  "author": "WoosopYi",
  "type": "module",
  "bin": {
    "redpen": "bin/redpen.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "README.ko.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node test/e2e/run.mjs",
    "demo": "node bin/redpen.mjs open examples/basic/index.html",
    "demo:en": "node bin/redpen.mjs open examples/basic-en/index.html --lang en",
    "screenshots": "node scripts/screenshots.mjs",
    "media": "node scripts/media/record.mjs && node scripts/media/render.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
